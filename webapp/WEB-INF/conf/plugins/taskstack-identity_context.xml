<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd" >

    <bean id="taskstack-identity.account.creation.management" class="fr.paris.lutece.plugins.identitystore.modules.taskstack.provider.AccountCreationRequestManagement" />
    <bean id="taskstack-identity.email.validation.management" class="fr.paris.lutece.plugins.identitystore.modules.taskstack.provider.EmailValidationRequestManagement" />
    <bean id="taskstack-identity.account.merge.management" class="fr.paris.lutece.plugins.identitystore.modules.taskstack.provider.AccountMergeRequestManagement" />
    <bean id="taskstack-identity.account.identity.merge.management" class="fr.paris.lutece.plugins.identitystore.modules.taskstack.provider.AccountIdentityMergeRequestManagement" />
    <bean id="taskstack-identity.attachment.certification.management" class="fr.paris.lutece.plugins.identitystore.modules.taskstack.provider.AttachmentCertificationRequestManagement" />

    <!-- DAO -->
    <bean id="taskstack-identity.client-task-right.dao" class="fr.paris.lutece.plugins.identitystore.modules.taskstack.business.ClientTaskRightDAO" />

    <!-- REST -->
    <bean id="taskstack-identity.clientTaskRightRest" class="fr.paris.lutece.plugins.identitystore.modules.taskstack.web.rs.ClientTaskRightRest" />
</beans>